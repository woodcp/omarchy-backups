# omarchy-backups configuration. Copy to ~/.config/omarchy-backups/config.

# restic repository directory (on the backup drive).
REPO=/mnt/cold-storage/Omarchy/restic

# Mount point of the backup drive. The backup refuses to run unless this is
# a live mount, so an unplugged drive is a clean skip, not a backup to nowhere.
MOUNT=/mnt/cold-storage

# Retention: how many snapshots to keep when pruning.
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6
KEEP_YEARLY=2

# How long an operation waits for a busy repository before giving up, instead
# of failing immediately when another backup or check holds the lock.
RETRY_LOCK=1m
